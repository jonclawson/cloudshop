# Terraform variables for deployment
# Set these via GitHub Secrets or environment variables

# Required infrastructure credentials
cloudflare_api_token = ""  # Set via TF_VAR_cloudflare_api_token
account_id           = ""  # Set via TF_VAR_account_id
github_token         = ""  # Set via TF_VAR_github_token (for Pages linking)

# Configuration
domain               = "cloudshop.example.com"
environment          = "production"

# Secrets (passed via GitHub Secrets → TF_VAR_*)
jwt_secret           = ""  # Set via TF_VAR_jwt_secret
stripe_secret_key    = ""  # Set via TF_VAR_stripe_secret_key
stripe_publishable_key = ""  # Set via TF_VAR_stripe_publishable_key (not sensitive, can be public)
stripe_webhook_secret = ""  # Set via TF_VAR_stripe_webhook_secret
printful_api_key     = ""  # Set via TF_VAR_printful_api_key
mailchannels_api_key = ""  # Set via TF_VAR_mailchannels_api_key

# Optional: Public environment variables for Worker
worker_env_vars = {
  ENVIRONMENT = "production"
  USE_MOCKS   = "false"
}

# Optional: Secret environment variables (can be passed as map)
worker_secrets = {}
